# ==============================================================================
# SIGAP — Agen Karhutla Environment Configuration Template
# Copy this file to .env and fill in the required values.
# Do NOT commit actual secrets or credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Google Cloud / Vertex AI (Agent Orchestration & DINOv3 Model Endpoint)
# ------------------------------------------------------------------------------
# Google Cloud project ID for Vertex AI (Gemini models + DINOv3 Endpoint) and Earth Engine
GOOGLE_CLOUD_PROJECT=

# Absolute or relative path to your Google Cloud service account JSON credentials key
GOOGLE_APPLICATION_CREDENTIALS=

# Vertex AI region and Endpoint ID for the deployed DINOv3 BurnSeg model
VERTEX_LOCATION=us-west1
VERTEX_DINOV3_ENDPOINT_ID=936548611376807936

# Optional: Full custom endpoint URL (overrides VERTEX_DINOV3_ENDPOINT_ID if set)
DINOV3_ENDPOINT_URL=https://us-west1-aiplatform.googleapis.com/v1/projects/hackathon-primestep-04/locations/us-west1/endpoints/936548611376807936:predict

# ------------------------------------------------------------------------------
# Google Earth Engine (GEE)
# ------------------------------------------------------------------------------
# Google Cloud project ID with Earth Engine API enabled
EARTH_ENGINE_PROJECT=

# ------------------------------------------------------------------------------
# NASA FIRMS (Fire Information for Resource Management System)
# ------------------------------------------------------------------------------
# API Map Key from NASA FIRMS (get one at: https://firms.modaps.eosdis.nasa.gov/api/map_key/)
NASA_FIRMS_API_KEY=

# ------------------------------------------------------------------------------
# Database & Cache
# ------------------------------------------------------------------------------
# PostgreSQL / PostGIS database connection URL
DATABASE_URL=

# Redis cache and task state broker URL
REDIS_URL=

# ------------------------------------------------------------------------------
# Frontend Settings
# ------------------------------------------------------------------------------
# Base URL of the FastAPI backend for Next.js client-side requests
NEXT_PUBLIC_API_URL=

# Mapbox Access Token for vector basemaps (optional, Leaflet / OSM can be used without token)
NEXT_PUBLIC_MAPBOX_TOKEN=
